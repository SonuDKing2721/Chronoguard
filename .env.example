# Chronoguard — Environment Variables Template
# Copy this file to .env and fill in your values.
# .env is gitignored and NEVER committed to the repository.
#
# Usage in Python:
#   import os
#   from dotenv import load_dotenv
#   load_dotenv()
#   token = os.environ.get("GITHUB_TOKEN")

# GitHub Personal Access Token (optional — only needed for GitHub API calls)
# Generate at: https://github.com/settings/tokens
# Required scopes: repo (read-only is sufficient)
GITHUB_TOKEN=your_github_token_here

# Optional: Dataset path override (leave blank to use data/ directory)
# CHRONOGUARD_DATA_DIR=/path/to/your/data
