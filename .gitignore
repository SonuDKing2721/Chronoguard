# ── Python cache ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc

# ── Virtual environments ───────────────────────────────────────
.venv/
venv/
env/
.env

# ── Secrets (NEVER commit tokens or credentials) ──────────────
.env
*.env
secrets.py

# ── Jupyter ───────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Data files — keep only the committed train/test CSVs ──────
*.csv
!data/train.csv
!data/test.csv
!data/attack_sim.csv

# ── Model files (large binaries — optional to exclude) ────────
# Uncomment the lines below if you don't want to commit .joblib files
# models/*.joblib

# ── OS files ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE files ─────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo